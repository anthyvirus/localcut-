{
  "name": "localcut",
  "productName": "LocalCut",
  "version": "0.1.0",
  "description": "Offline-first desktop editor that turns long streams and vlogs into vertical clips, locally.",
  "license": "MIT",
  "private": true,
  "main": "dist/main/main/index.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:main && npm run build:renderer",
    "start": "electron .",
    "dev": "npm run build:main && vite build --watch & electron .",
    "typecheck": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run",
    "dist:win": "npm run build && electron-builder --win",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "obs-websocket-js": "5.0.8"
  },
  "devDependencies": {
    "@types/node": "22.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.8.0",
    "electron-builder": "26.15.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.5"
  },
  "build": {
    "appId": "io.localcut.app",
    "productName": "LocalCut",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "assets/fonts",
        "to": "fonts"
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "LocalCut-${version}-${arch}-${target}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "category": "AudioVideo"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    }
  },
  "author": "LocalCut contributors",
  "homepage": "https://github.com/YOUR-ACCOUNT/localcut"
}
